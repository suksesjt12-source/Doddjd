--- a/src/video_core/renderer_vulkan/vk_present_manager.cpp
+++ b/src/video_core/renderer_vulkan/vk_present_manager.cpp
@@ -23,6 +23,9 @@
 namespace {
 
 constexpr size_t MAX_FRAMES_IN_FLIGHT = 7;
+// Mali mobile GPUs use a shallower presentation queue when frame generation is off.
+// When LSFG is active, its generation count determines the queue depth instead.
+constexpr size_t MAX_MALI_PRESENT_FRAMES_IN_FLIGHT = 3;
 #ifdef HAS_LSFG
 static_assert(MAX_FRAMES_IN_FLIGHT <= LSFG_MAX_TARGETS);
 #endif
@@ -360,17 +363,27 @@
 }
 
 void PresentManager::SetImageCount() {
-    // We cannot have more than 7 images in flight at any given time.
-    // FRAMES_IN_FLIGHT is 8, and the cache TICKS_TO_DESTROY is 8.
-    // Mali drivers will give us 6.
+    // Keep the presentation pool below the maximum cache lifetime. ARM Mali uses a smaller
+    // pool when frame generation is disabled; the LSFG path retains its required queue depth.
 #ifdef HAS_LSFG
     const size_t generations = Settings::FrameGenMaxGenerations();
+    const bool is_arm_mali = device.GetDriverID() == VK_DRIVER_ID_ARM_PROPRIETARY;
+    if (is_arm_mali && generations == 0) {
+        // Avoid allocating six internal frames just because Mali exposes a six-image swapchain.
+        // Three frames keep a small amount of overlap while limiting queue depth and memory use.
+        image_count =
+            std::min<size_t>(swapchain.GetImageCount(), MAX_MALI_PRESENT_FRAMES_IN_FLIGHT);
+        return;
+    }
     const size_t queued_composites = Settings::values.frame_gen_queue_target.GetValue() + 1;
     image_count =
         std::clamp<size_t>((generations + 1) * queued_composites, swapchain.GetImageCount(),
                            MAX_FRAMES_IN_FLIGHT);
 #else
-    image_count = std::min<size_t>(swapchain.GetImageCount(), MAX_FRAMES_IN_FLIGHT);
+    const bool is_arm_mali = device.GetDriverID() == VK_DRIVER_ID_ARM_PROPRIETARY;
+    const size_t max_frames =
+        is_arm_mali ? MAX_MALI_PRESENT_FRAMES_IN_FLIGHT : MAX_FRAMES_IN_FLIGHT;
+    image_count = std::min<size_t>(swapchain.GetImageCount(), max_frames);
 #endif
 }
